# Copy to .env.docker (ignored by Git); local loopback simulation only.
# Prefer npm run local:setup to obtain real local Supabase keys.
# Browser variables are baked into the image; rebuild when they change.
TORNEOS_ENVIRONMENT=local
TORNEOS_LOCAL_MODE=1
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVER_URL=http://host.docker.internal:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=REEMPLAZAR_CLAVE_LOCAL
SUPABASE_SECRET_KEY=REEMPLAZAR_CLAVE_LOCAL_PRIVADA
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3081
APP_URL=http://127.0.0.1:3081
FLOW_API_BASE=http://127.0.0.1:3000/api/local-flow
FLOW_API_KEY=REEMPLAZAR_CLAVE_SIMULADOR
FLOW_API_SECRET=REEMPLAZAR_SECRETO_SIMULADOR
TORNEOS_RUNTIME_ENV_FILE=.env.docker
TORNEOS_PORT=3081
TORNEOS_BIND_IP=127.0.0.1
# Staging requires its own HTTPS origin, protected production ref and complete
# Flow sandbox/email/cron/company runtime configuration; see the RM-11 runbook.
